{
  "name": "intl-date",
  "version": "0.3.0",
  "description": "Immutable TypeScript/JavaScript date library for Gregorian, Hijri/Islamic, Umm al-Qura, and Persian/Jalali calendar conversion, formatting, comparison, and date arithmetic.",
  "keywords": [
    "date",
    "date-library",
    "calendar",
    "multi-calendar",
    "calendar-conversion",
    "calendar-converter",
    "date-conversion",
    "date-converter",
    "date-arithmetic",
    "date-manipulation",
    "date-comparison",
    "date-formatting",
    "immutable-date",
    "gregorian",
    "gregorian-calendar",
    "hijri",
    "hijri-date",
    "hijri-calendar",
    "islamic",
    "islamic-date",
    "islamic-calendar",
    "islamic-umalqura",
    "umm-al-qura",
    "islamic-rgsa",
    "islamic-civil",
    "islamic-tbla",
    "persian",
    "persian-calendar",
    "persian-date",
    "jalali"
  ],
  "author": "Khalid H. Alharisi",
  "license": "Apache-2.0",
  "homepage": "https://github.com/coder966/intl-date",
  "repository": {
    "type": "git",
    "url": "https://github.com/coder966/intl-date"
  },
  "private": false,
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "test": "jest"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/node": "^22.20.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
